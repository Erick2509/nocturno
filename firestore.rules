rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));}
  function active(){return signed() && profile().data.activo == true;}
  function admin(){return active() && profile().data.role == 'admin';}
  function agent(){return active() && profile().data.role == 'agente';}
  function mine(uid){return active() && request.auth.uid == uid;}
  function ts(){return request.time;}
  match /usuarios/{uid}{allow get: if admin() || mine(uid);allow list: if admin();allow create: if admin() && request.resource.data.keys().hasOnly(['nombre','usuario','email','role','activo','creadoEn']) && request.resource.data.role == 'agente' && request.resource.data.activo == true && request.resource.data.creadoEn == ts();allow update: if admin() && resource.data.role == 'agente' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo','nombre']) && request.resource.data.role == resource.data.role;allow delete: if false;}
  match /agentes/{uid}{allow get: if admin() || mine(uid);allow list: if admin();allow create: if admin() && existsAfter(/databases/$(database)/documents/usuarios/$(uid)) && getAfter(/databases/$(database)/documents/usuarios/$(uid)).data.role == 'agente' && request.resource.data.uid == uid && request.resource.data.keys().hasOnly(['uid','nombre','usuario','codigo','dni','telefono','cargo','activo','creadoEn']) && request.resource.data.creadoEn == ts();allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','dni','telefono','cargo','activo']) && request.resource.data.uid == uid;allow delete: if false;}
  match /servicios/{id}{allow read: if admin() || (agent() && resource.data.activo == true);allow create: if admin() && request.resource.data.keys().hasOnly(['nombre','empresa','direccion','puesto','instrucciones','activo','creadoEn']) && request.resource.data.creadoEn == ts();allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','empresa','direccion','puesto','instrucciones','activo']);allow delete: if false;}
  match /turnos/{id}{allow read: if admin() || (agent() && resource.data.agenteId == request.auth.uid);allow create: if admin() && request.resource.data.keys().hasOnly(['agenteId','agenteNombre','servicioId','servicioNombre','puesto','tipoTurno','inicio','fin','creadoEn']) && request.resource.data.tipoTurno in ['Diurno','Nocturno'] && request.resource.data.inicio is timestamp && request.resource.data.fin is timestamp && request.resource.data.fin > request.resource.data.inicio && request.resource.data.creadoEn == ts() && get(/databases/$(database)/documents/usuarios/$(request.resource.data.agenteId)).data.activo == true && get(/databases/$(database)/documents/servicios/$(request.resource.data.servicioId)).data.activo == true;allow update,delete: if false;}
  match /actividades/{id}{allow read: if admin() || (agent() && resource.data.agenteId == request.auth.uid);allow create: if admin() && request.resource.data.keys().hasOnly(['agenteId','agenteNombre','servicioId','servicioNombre','turnoId','tipoTurno','titulo','descripcion','inicio','limite','finTurno','estado','creadoEn']) && request.resource.data.tipoTurno == get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.tipoTurno && request.resource.data.estado == 'pendiente' && request.resource.data.creadoEn == ts() && request.resource.data.inicio is timestamp && request.resource.data.limite is timestamp && request.resource.data.finTurno is timestamp && request.resource.data.inicio < request.resource.data.limite && request.resource.data.limite <= request.resource.data.finTurno && get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.agenteId == request.resource.data.agenteId && get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.servicioId == request.resource.data.servicioId && request.resource.data.inicio >= get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.inicio && request.resource.data.finTurno == get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.fin;
   allow update: if agent() && resource.data.agenteId == request.auth.uid && (
    (resource.data.estado == 'pendiente' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','realizadoEn']) && request.resource.data.realizadoEn == ts() && request.resource.data.estado == (ts() <= resource.data.limite ? 'realizada' : 'realizada_tarde') && ts() >= resource.data.inicio && ts() <= resource.data.finTurno)
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['justificacion','justificadoEn']) && request.resource.data.justificacion is string && request.resource.data.justificacion.size() >= 5 && request.resource.data.justificacion.size() <= 1500 && request.resource.data.justificadoEn == ts() && ts() > resource.data.limite && !('justificacion' in resource.data))
   );allow delete: if false;}
  match /incidencias/{id}{allow read: if admin() || (agent() && resource.data.agenteId == request.auth.uid);allow create: if agent() && request.resource.data.keys().hasOnly(['agenteId','agenteNombre','servicioId','servicioNombre','turnoId','tipo','descripcion','estado','creadoEn']) && request.resource.data.agenteId == request.auth.uid && request.resource.data.estado == 'pendiente' && request.resource.data.creadoEn == ts() && request.resource.data.descripcion is string && request.resource.data.descripcion.size() >= 5 && request.resource.data.descripcion.size() <= 3000 && request.resource.data.tipo in ['Novedad general','Ingreso no autorizado','Falla de equipos','Emergencia','Otro'] && get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.agenteId == request.auth.uid && get(/databases/$(database)/documents/turnos/$(request.resource.data.turnoId)).data.servicioId == request.resource.data.servicioId;allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','revisadaEn']) && request.resource.data.estado in ['revisada','cerrada'] && request.resource.data.revisadaEn == ts();allow delete: if false;}
  match /{document=**}{allow read,write: if false;}
 }
}
